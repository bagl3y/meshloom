# Meshloom configuration
# https://github.com/bagl3y/meshloom
#
# Uncomment ONE transport section. Serial auto-detect is the default
# when none of the transport variables are set.

# Serial manual port
#MESHCORE_SERIAL_PORT=/dev/ttyUSB0

# TCP
#MESHCORE_TCP_HOST=192.168.1.100
#MESHCORE_TCP_PORT=5000

# BLE
#MESHCORE_BLE_ADDRESS=AA:BB:CC:DD:EE:FF
#MESHCORE_BLE_PIN=123456

MESHCORE_DATABASE_PATH=/var/lib/meshloom/meshcore.db

# Bots execute arbitrary Python on the server.
MESHCORE_DISABLE_BOTS=true

#MESHCORE_BASIC_AUTH_USERNAME=
#MESHCORE_BASIC_AUTH_PASSWORD=
#MESHCORE_ENABLE_LOCAL_PRIVATE_KEY_EXPORT=false
